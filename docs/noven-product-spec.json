{
  "meta": {
    "product_name": "Noven",
    "platform": "iOS",
    "theme": "minimal_monochrome_psychological_os",
    "design_language": "calm_premium_editorial"
  },
  "foundation": {
    "canvas": {
      "width": 393,
      "height": 852,
      "safe_area_top": 59,
      "safe_area_bottom": 34
    },
    "colors": {
      "background": "#FFFFFF",
      "foreground": "#0D0D0F",
      "muted_text": "#6F6F73",
      "soft_text": "#9A9AA1",
      "border": "#ECECEF",
      "surface": "#F7F7F8",
      "surface_dark": "#0D0D0F",
      "success": "#1F9D55",
      "warning": "#E7A500",
      "danger": "#D92D20"
    },
    "spacing": {
      "screen_horizontal": 28,
      "section_gap": 36,
      "component_gap": 18,
      "small_gap": 10
    },
    "radius": {
      "button": 18,
      "input": 16,
      "card": 28,
      "pill": 999
    },
    "typography": {
      "display": {
        "font": "Playfair Display",
        "size": 40,
        "line_height": 50,
        "weight": 400
      },
      "heading": {
        "font": "Playfair Display",
        "size": 30,
        "line_height": 40,
        "weight": 400
      },
      "body": {
        "font": "Inter",
        "size": 16,
        "line_height": 26,
        "weight": 400
      },
      "small": {
        "font": "Inter",
        "size": 14,
        "line_height": 22,
        "weight": 400
      },
      "caption": {
        "font": "Inter",
        "size": 12,
        "line_height": 16,
        "weight": 600,
        "letter_spacing": 2
      }
    }
  },
  "illustration_system": {
    "style": {
      "type": "2d_monochrome_vector",
      "rules": [
        "transparent_png",
        "no_ui",
        "no_text",
        "no_phone_frame",
        "soft_grayscale",
        "editorial_anime_inspired",
        "subtle_glow",
        "mist_and_planet_language",
        "minimal_linework",
        "low_visual_noise"
      ]
    },
    "assets": [
      {
        "id": "welcome_reflection_wide",
        "description": "Wide reflective onboarding scene"
      },
      {
        "id": "name_writing_clean",
        "description": "Clean writing scene for name entry"
      },
      {
        "id": "standing_future_character",
        "description": "Standing facing horizon"
      }
    ]
  },
  "navigation": {
    "bottom_tabs": [
      "Home",
      "Habits",
      "Patterns",
      "Profile"
    ]
  },
